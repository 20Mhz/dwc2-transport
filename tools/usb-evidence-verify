# SPDX-License-Identifier: MIT
import argparse
import json
from pathlib import Path
import sys
here=Path(__file__).resolve().parent
for root in (here.parent,here.parent/'share/dwc2-transport'):
    if (root/'python/dwc2_diag').is_dir():
        sys.path.insert(0,str(root/'python'));break
from dwc2_diag.evidence import validate_bundle
from dwc2_diag.recording import validate_release_evidence
from dwc2_diag.timeline import validate_session
parser=argparse.ArgumentParser(description='Verify M6/M7/M8 evidence integrity and reported results')
parser.add_argument('bundle',type=Path)
args=parser.parse_args()
try:
    milestone=json.loads((args.bundle/'result.json').read_text()).get('milestone')
except (OSError, ValueError, AttributeError):
    milestone=None
errors=validate_session(args.bundle) if milestone=='M8' else validate_release_evidence(args.bundle) if milestone=='M7' else validate_bundle(args.bundle)
report={'valid':not errors,'errors':errors}
if milestone=='M7':
    result=json.loads((args.bundle/'result.json').read_text())
    tests=result.get('tests',{})
    if not isinstance(tests,dict):tests={}
    report.update(validation_scope='integrity_and_consistency',
                  physical_validation_complete=result.get('physical_validation_complete') is True,
                  test_status={name:item.get('status') for name,item in tests.items() if isinstance(item,dict)})
if milestone=='M8':
    result=json.loads((args.bundle/'result.json').read_text())
    report.update(validation_scope='single_session_integrity_and_consistency',
                  identity_change_captured=result.get('identity_change_captured') is True,
                  outcome=result.get('outcome'),procedure_status=result.get('procedure_status'))
print(json.dumps(report))
raise SystemExit(bool(errors))
